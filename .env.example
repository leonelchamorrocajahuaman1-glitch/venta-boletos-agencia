PORT=3000
# 0.0.0.0 = acepta clientes de la red local; 127.0.0.1 = solo esta computadora
HOST=0.0.0.0
# Administrador creado en el primer arranque
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123
# Ruta del archivo SQLite
DB_PATH=./data/boletos.db
# Secreto para firmar los QR (si se omite se genera uno y se guarda en la BD)
QR_SECRET=
# Minutos que un asiento queda bloqueado mientras el cliente paga
BLOQUEO_MINUTOS=5
# Impresora térmica de red (ESC/POS, puerto RAW 9100). Opcional.
PRINTER_HOST=
PRINTER_PORT=9100
